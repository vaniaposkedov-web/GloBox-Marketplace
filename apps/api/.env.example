# ——— Server ———
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000

# ——— PostgreSQL ———
DATABASE_URL=postgresql://marketplace:marketplace_dev@localhost:5432/marketplace?schema=public

# ——— Redis ———
REDIS_URL=redis://localhost:6379

# ——— JWT ———
JWT_SECRET=change_me_to_random_32_bytes
JWT_ACCESS_TTL=30d

# ——— Mail (Yandex SMTP) ———
# Для Yandex: создайте пароль приложения → https://id.yandex.ru/security/app-passwords
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your_email@yandex.ru
SMTP_PASS=your_app_password
SMTP_FROM="Marketplace <your_email@yandex.ru>"

# ——— SMS провайдер ———
# stub = не отправлять | smsru = SMS.RU | smsc = SMSC.ru
SMS_PROVIDER=stub
SMS_API_KEY=
SMS_TEST_MODE=true
# SMSC.ru (если SMS_PROVIDER=smsc)
SMSC_LOGIN=
SMSC_PASSWORD=
SMSC_SENDER=

# ——— VK OAuth (1.3) ———
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=https://your-domain.ru/auth/vk/callback

# ——— MAX (max.ru) бот ———
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=

# ——— Dev: показывать коды в ответе API (email/sms) ———
DEV_EXPOSE_CODES=true

# ——— Captcha ———
CAPTCHA_PROVIDER=disabled
CAPTCHA_SECRET=
